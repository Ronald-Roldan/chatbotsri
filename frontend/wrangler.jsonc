{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "frontend",
  "main": "./worker.js",
  "compatibility_date": "2026-10-24",
  "ai": {
    "binding": "AI"
  },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  }
}
